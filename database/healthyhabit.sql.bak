-- =====================================================================
-- 10. TABEL: ulasan_rating
-- =====================================================================
DROP TABLE IF EXISTS `ulasan_rating`;
CREATE TABLE `ulasan_rating` (
    `id_usulan_rating` INT(11)   NOT NULL AUTO_INCREMENT,
    `id_pengguna`      INT(11)   NOT NULL,
    `id_tempat`        INT(11)   NOT NULL,
    `rating`           TINYINT(1) NOT NULL DEFAULT 5,
    `komentar`         TEXT,
    `tanggal_ulasan`   DATETIME  NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (`id_usulan_rating`),
    KEY `fk_ulasan_pengguna` (`id_pengguna`),
    KEY `fk_ulasan_tempat` (`id_tempat`),
    CONSTRAINT `fk_ulasan_pengguna` FOREIGN KEY (`id_pengguna`)
        REFERENCES `pengguna` (`id_pengguna`) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT `fk_ulasan_tempat` FOREIGN KEY (`id_tempat`)
        REFERENCES `tempat_sehat` (`id_tempat`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `ulasan_rating`
    (`id_usulan_rating`, `id_pengguna`, `id_tempat`, `rating`, `komentar`, `tanggal_ulasan`) VALUES
(1, 1, 1, 5, 'Jusnya segar tanpa gula tambahan, tempatnya bersih dan nyaman. Recommended!', '2026-03-10 10:15:00'),
(2, 2, 1, 4, 'Menu grilled chicken bowl-nya enak dan porsinya pas. Harga masih terjangkau.', '2026-03-12 19:40:00'),
(3, 1, 2, 5, 'Konsep build-your-own salad-nya menarik, informasi gizi tiap menu jelas.',   '2026-03-18 12:05:00');

-- =====================================================================
-- 11. TABEL: laporan_statistik
-- =====================================================================
DROP TABLE IF EXISTS `laporan_statistik`;
CREATE TABLE `laporan_statistik` (
    `id_laporan`     INT(11)  NOT NULL AUTO_INCREMENT,
    `id_admin`       INT(11)  DEFAULT NULL,
    `total_pengguna` INT(11)  NOT NULL DEFAULT 0,
    `total_artikel`  INT(11)  NOT NULL DEFAULT 0,
    `total_kalori`   INT(11)  NOT NULL DEFAULT 0,
    `total_resep`    INT(11)  NOT NULL DEFAULT 0,
    `total_tempat`   INT(11)  NOT NULL DEFAULT 0,
    `total_menu`     INT(11)  NOT NULL DEFAULT 0,
    `tanggal_cetak`  DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
