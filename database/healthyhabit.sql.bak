-- =====================================================================
-- 6. TABEL: resep
-- =====================================================================
DROP TABLE IF EXISTS `resep`;
CREATE TABLE `resep` (
    `id_resep`          INT(11)      NOT NULL AUTO_INCREMENT,
    `id_admin`          INT(11)      DEFAULT NULL,
    `judul_resep`       VARCHAR(180) NOT NULL,
    `deskripsi`         VARCHAR(255) NOT NULL,
    `bahan_bahan`       TEXT         NOT NULL,
    `langkah_pembuatan` TEXT         NOT NULL,
    `waktu_masak`       INT(11)      NOT NULL DEFAULT 0,
    `status_publikasi`  ENUM('draft','dipublikasikan') NOT NULL DEFAULT 'draft',
    `total_kalori`      INT(11)      NOT NULL DEFAULT 0,
    `foto_resep`        VARCHAR(255) DEFAULT NULL,
    PRIMARY KEY (`id_resep`),
    KEY `fk_resep_admin` (`id_admin`),
    CONSTRAINT `fk_resep_admin` FOREIGN KEY (`id_admin`)
        REFERENCES `admin` (`id_admin`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `resep`
    (`id_resep`, `id_admin`, `judul_resep`, `deskripsi`, `bahan_bahan`, `langkah_pembuatan`, `waktu_masak`, `status_publikasi`, `total_kalori`, `foto_resep`) VALUES
(1, 1, 'Salad Quinoa Ayam Panggang',
 'Salad tinggi protein dengan quinoa dan ayam panggang rendah lemak.',
 '100 gram quinoa mentah\n150 gram dada ayam\n50 gram selada romaine\n1 buah tomat cherry\n1 sdm minyak zaitun\n1 sdt perasan lemon\nLada hitam secukupnya',
 'Rebus quinoa dengan air selama 15 menit hingga mengembang.\nMarinasi ayam dengan lemon, lada, dan sedikit minyak zaitun.\nPanggang ayam selama 10 menit tiap sisi hingga matang.\nTata selada, tomat, dan quinoa dalam mangkuk.\nIris ayam panggang di atas salad dan sajikan.',
 25, 'dipublikasikan', 420, NULL),
(2, 1, 'Jus Alpukat Madu Low Sugar',
 'Minuman segar kaya lemak sehat, cocok untuk menu sarapan.',
 '1 buah alpukat matang\n200 ml air dingin\n1 sdm madu murni\n2 sdm susu kedelai\nEs batu secukupnya',
 'Keruk daging alpukat dan masukkan ke blender.\nTambahkan air dingin, madu, dan susu kedelai.\nBlender hingga halus dan lembut.\nTuang ke gelas, tambahkan es batu, lalu sajikan.',
 10, 'dipublikasikan', 210, NULL),
(3, 1, 'Sup Brokoli Tahu Putih',
 'Sup hangat rendah kalori dengan protein nabati yang mengenyangkan.',
 '150 gram brokoli\n100 gram tahu putih\n500 ml kaldu ayam rendah garam\n2 siung bawang putih\n1/2 bawang bombay\nSeledri secukupnya',
 'Tumis bawang putih dan bawang bombay tanpa minyak berlebih.\nMasukkan kaldu, didihkan.\nTambahkan tahu dan brokoli, masak 7 menit.\nBumbui lada dan sedikit garam, taburi seledri.\nSajikan selagi hangat.',
 20, 'dipublikasikan', 175, NULL),
(4, 1, 'Oatmeal Pisang Kismis (Draft)',
 'Sarapan cepat saji kaya serat, masih dalam tahap penyempurnaan resep.',
 '50 gram oatmeal instan\n1 buah pisang ambon\n1 sdm kismis\n200 ml susu rendah lemak',
 'Panaskan susu hingga hangat.\nMasukkan oatmeal, aduk hingga mengental.\nTambahkan irisan pisang dan kismis.\nSajikan hangat.',
 8, 'draft', 285, NULL);

-- =====================================================================
-- 7. TABEL: tempat_sehat
-- =====================================================================
DROP TABLE IF EXISTS `tempat_sehat`;
CREATE TABLE `tempat_sehat` (
    `id_tempat`   INT(11)      NOT NULL AUTO_INCREMENT,
    `id_admin`    INT(11)      DEFAULT NULL,
    `nama_tempat` VARCHAR(150) NOT NULL,
    `alamat`      VARCHAR(255) NOT NULL,
    `deskripsi`   TEXT,
    `kontak`      VARCHAR(50)  DEFAULT NULL,
    `foto_tempat` VARCHAR(255) DEFAULT NULL,
    `foto_menu`   VARCHAR(255) DEFAULT NULL,
    `link_maps`   VARCHAR(255) DEFAULT NULL,
    `link_instagram`  VARCHAR(255) DEFAULT NULL,
    `link_grabfood`   VARCHAR(255) DEFAULT NULL,
    `link_shopeefood` VARCHAR(255) DEFAULT NULL,
    PRIMARY KEY (`id_tempat`),
    KEY `fk_tempat_admin` (`id_admin`),
    CONSTRAINT `fk_tempat_admin` FOREIGN KEY (`id_admin`)
        REFERENCES `admin` (`id_admin`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `tempat_sehat`
    (`id_tempat`, `id_admin`, `nama_tempat`, `alamat`, `deskripsi`, `kontak`, `foto_tempat`, `foto_menu`, `link_maps`) VALUES
(1, 1, 'RealJuice Healthy Café',
 'Jl. Veteran No. 88, Padang, Sumatera Barat',
 'Kafe sehat yang menyajikan aneka jus segar tanpa gula tambahan, salad bowl, serta menu rendah kalori. Semua bahan dipilih harian dari petani lokal.',
 '0812-3456-7890', NULL, NULL, 'https://maps.google.com/?q=RealJuice+Healthy+Cafe+Padang'),
(2, 1, 'Salad Bar Segar Hijau',
 'Jl. Gajah Mada No. 12, Padang, Sumatera Barat',
 'Kedai salad dengan konsep build-your-own bowl. Tersedia pilihan protein nabati dan hewani dengan informasi gizi pada setiap menunya.',
 '0813-9876-5432', NULL, NULL, 'https://maps.google.com/?q=Salad+Bar+Segar+Hijau+Padang');

-- =====================================================================
-- 8. TABEL: menu  (sub-menu makanan/minuman per tempat)
-- =====================================================================
DROP TABLE IF EXISTS `menu`;
CREATE TABLE `menu` (
    `id_menu`        INT(11)      NOT NULL AUTO_INCREMENT,
    `id_tempat`      INT(11)      NOT NULL,
    `nama_menu`      VARCHAR(150) NOT NULL,
    `deskripsi`      TEXT,
    `harga`          INT(11)      NOT NULL DEFAULT 0,
    `protein`        DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `karbohidrat`    DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `lemak`          DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `estimasi_waktu` INT(11)      NOT NULL DEFAULT 0,
    `foto_menu`      VARCHAR(255) DEFAULT NULL,
    `id_kategori_menu` INT(11)     DEFAULT NULL,
    PRIMARY KEY (`id_menu`),
    KEY `fk_menu_tempat` (`id_tempat`),
    CONSTRAINT `fk_menu_tempat` FOREIGN KEY (`id_tempat`)
        REFERENCES `tempat_sehat` (`id_tempat`) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT `fk_menu_kategori` FOREIGN KEY (`id_kategori_menu`)
        REFERENCES `menu_categories` (`id_kategori_menu`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =====================================================================
-- 8b. TABEL: menu_categories  (kategori pengelompokan menu per tempat)
-- =====================================================================
DROP TABLE IF EXISTS `menu_categories`;
CREATE TABLE `menu_categories` (
    `id_kategori_menu`  INT(11)      NOT NULL AUTO_INCREMENT,
    `nama_kategori`     VARCHAR(80)  NOT NULL,
    `deskripsi`         TEXT         DEFAULT NULL,
    PRIMARY KEY (`id_kategori_menu`),
    UNIQUE KEY `uq_menu_cat_nama` (`nama_kategori`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `menu_categories` (`id_kategori_menu`, `nama_kategori`, `deskripsi`) VALUES
