(5, 1, 'Tahu Putih Kukus',         'Makanan', '100 gram',  76.00,  1.90,  8.10,  4.80),
(6, 1, 'Alpukat Matang',           'Makanan', '100 gram', 160.00,  8.50,  2.00, 14.70),
(7, 1, 'Brokoli Rebus',            'Makanan', '100 gram',  35.00,  7.20,  2.40,  0.40),
(8, 1, 'Oatmeal (tanak air)',      'Makanan', '100 gram',  71.00, 12.00,  2.50,  1.50),
(9, 1, 'Jus Alpukat Madu',         'Minuman', '100 gram', 115.00, 13.00,  1.20,  6.50),
