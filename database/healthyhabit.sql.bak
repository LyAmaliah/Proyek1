-- =====================================================================
--  HealthyHabit — Skema Database MySQL
--  Sistem Pembentukan Kebiasaan Hidup Sehat Berbasis Web Native
--
--  Cara impor:
--   1. Jalankan Apache & MySQL dari XAMPP Control Panel
--   2. Buka http://localhost/phpmyadmin
--   3. Menu "Import" → pilih file ini → Go
--      (script sudah membuat database `healthyhabit` secara otomatis)
--
--  Akun bawaan:
--   • Admin : username `admin`  / password `admin123`
--   • User  : username `andi_sehat` / password `user123`
--             username `sari_dewi`  / password `user123`
-- =====================================================================

SET SQL_MODE = "NO_AUTO_VALUE_ON_ZERO";
SET time_zone = "+07:00";
SET NAMES utf8mb4;

-- Izinkan import ulang (reset) meski tabel sudah ada & berelasi
SET FOREIGN_KEY_CHECKS = 0;

CREATE DATABASE IF NOT EXISTS `healthyhabit`
    DEFAULT CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE `healthyhabit`;

-- =====================================================================
-- 1. TABEL: admin
-- =====================================================================
DROP TABLE IF EXISTS `admin`;
CREATE TABLE `admin` (
    `id_admin`  INT(11)      NOT NULL AUTO_INCREMENT,
    `username`  VARCHAR(50)  NOT NULL,
    `password`  VARCHAR(255) NOT NULL,
    PRIMARY KEY (`id_admin`),
    UNIQUE KEY `uq_admin_username` (`username`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `admin` (`id_admin`, `username`, `password`) VALUES
(1, 'admin', '$2y$10$eU3P1ieECi3zYzD7G9KVFOMt9GCZjrSqnxZp043c5DOwXJhIr4FYi'); -- admin123

-- =====================================================================
-- 2. TABEL: kategori_artikel  (pendukung relasi id_kategori_artikel)
-- =====================================================================
DROP TABLE IF EXISTS `kategori_artikel`;
CREATE TABLE `kategori_artikel` (
    `id_kategori_artikel` INT(11)     NOT NULL AUTO_INCREMENT,
    `nama_kategori`       VARCHAR(60) NOT NULL,
    PRIMARY KEY (`id_kategori_artikel`),
    UNIQUE KEY `uq_kategori_nama` (`nama_kategori`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `kategori_artikel` (`id_kategori_artikel`, `nama_kategori`) VALUES
(1, 'Nutrisi'),
(2, 'Olahraga'),
(3, 'Kesehatan Mental'),
(4, 'Tips Harian'),
(5, 'Diet Sehat');

-- =====================================================================
-- 3. TABEL: pengguna
-- =====================================================================
DROP TABLE IF EXISTS `pengguna`;
CREATE TABLE `pengguna` (
    `id_pengguna`   INT(11)      NOT NULL AUTO_INCREMENT,
    `username`      VARCHAR(50)  NOT NULL,
    `password`      VARCHAR(255) NOT NULL,
    `nama_lengkap`  VARCHAR(100) NOT NULL,
    `berat_badan`   DECIMAL(5,2) NOT NULL DEFAULT 0.00,
    `tinggi_badan`  DECIMAL(5,2) NOT NULL DEFAULT 0.00,
    `jenis_kelamin` ENUM('L','P') NOT NULL DEFAULT 'L',
    `umur`          INT(11)      NOT NULL DEFAULT 0,
    `created_at`    DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (`id_pengguna`),
    UNIQUE KEY `uq_pengguna_username` (`username`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `pengguna`
    (`id_pengguna`, `username`, `password`, `nama_lengkap`, `berat_badan`, `tinggi_badan`, `jenis_kelamin`, `umur`, `created_at`) VALUES
(1, 'andi_sehat', '$2y$10$HdlM0uEE6ZXs1Aqk0yuZTO4id4xz2unxPUd90TuA/1YS/48.Y2x/W', 'Andi Pratama',  62.50, 170.00, 'L', 24, '2026-01-15 09:20:00'),
(2, 'sari_dewi',  '$2y$10$HdlM0uEE6ZXs1Aqk0yuZTO4id4xz2unxPUd90TuA/1YS/48.Y2x/W', 'Sari Dewi',     55.00, 160.00, 'P', 27, '2026-02-02 14:05:00');

-- =====================================================================
-- 4. TABEL: artikel_kesehatan
-- =====================================================================
DROP TABLE IF EXISTS `artikel_kesehatan`;
CREATE TABLE `artikel_kesehatan` (
    `id_artikel`          INT(11)      NOT NULL AUTO_INCREMENT,
    `id_kategori_artikel` INT(11)      DEFAULT NULL,
    `id_admin`            INT(11)      DEFAULT NULL,
    `judul_artikel`       VARCHAR(180) NOT NULL,
    `isi_artikel`         TEXT         NOT NULL,
    `foto_artikel`        VARCHAR(255) DEFAULT NULL,
    `tanggal_terbit`      DATE         NOT NULL,
    PRIMARY KEY (`id_artikel`),
    KEY `fk_artikel_kategori` (`id_kategori_artikel`),
    KEY `fk_artikel_admin` (`id_admin`),
    CONSTRAINT `fk_artikel_kategori` FOREIGN KEY (`id_kategori_artikel`)
        REFERENCES `kategori_artikel` (`id_kategori_artikel`) ON DELETE SET NULL ON UPDATE CASCADE,
    CONSTRAINT `fk_artikel_admin` FOREIGN KEY (`id_admin`)
        REFERENCES `admin` (`id_admin`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `artikel_kesehatan`
    (`id_artikel`, `id_kategori_artikel`, `id_admin`, `judul_artikel`, `isi_artikel`, `foto_artikel`, `tanggal_terbit`) VALUES
(1, 1, 1, 'Panduan Gizi Seimbang: Isi Piringku untuk Keluarga Sehat',
 'Gizi seimbang bukan berarti mahal. Konsep "Isi Piringku" dari Kementerian Kesehatan membagi satu piring makan menjadi 50% sayur dan buah, serta 50% makanan pokok dan lauk-pauk.\n\nPastikan setengah piring berisi sayur dan buah dengan warna beragam. Semakin beragam warna, semakin lengkap mikronutrien yang masuk ke tubuh Anda.\n\nLengkapi pula dengan aktivitas fisik minimal 30 menit sehari, minum air putih 8 gelas, dan cuci tangan sebelum makan. Kebiasaan kecil yang konsisten akan memberi hasil besar bagi kesehatan jangka panjang.',
 NULL, '2026-03-01'),
(2, 2, 1, '5 Olahraga Ringan yang Bisa Dilakukan di Rumah',
 'Tidak semua olahraga membutuhkan gym. Berikut lima aktivitas yang bisa dilakukan di rumah tanpa alat khusus:\n\n1. Jalan cepat di tempat selama 15-20 menit.\n2. Push-up dengan variasi lutut menyentuh lantai untuk pemula.\n3. Squat untuk memperkuat otot kaki dan bokong.\n4. Plank untuk melatih otot inti (core) selama 30 detik hingga 2 menit.\n5. Stretching ringan untuk melenturkan otot setelah beraktivitas.\n\nLakukan 3-5 kali seminggu dan lakukan pemanasan sebelum mulai agar terhindar dari cedera.',
 NULL, '2026-03-08'),
(3, 3, 1, 'Mengelola Stres dengan Teknik Pernapasan 4-7-8',
 'Stres berkepanjangan berdampak buruk pada tekanan darah, pola tidur, dan sistem imun. Salah satu teknik sederhana dan efektif adalah pernapasan 4-7-8.\n\nCaranya: tarik napas melalui hidung selama 4 detik, tahan selama 7 detik, lalu buang perlahan melalui mulut selama 8 detik. Ulangi 4 siklus, dua kali sehari.\n\nKombinasikan dengan jurnal syukur harian dan kurangi konsumsi kafein berlebih agar kualitas tidur Anda semakin baik.',
 NULL, '2026-03-15'),
(4, 4, 1, 'Mulai Hari dengan 6 Kebiasaan Kecil yang Berdampak Besar',
 'Kebiasaan sehat tidak harus dimulai dengan perubahan besar. Mulailah dari 6 hal berikut:\n\nMinum segelas air putih setelah bangun tidur, meregangkan badan 5 menit, sarapan tinggi protein, berjalan pagi 10 menit, menulis satu target harian, dan tidur sebelum pukul 23.00.\n\nCatat progres Anda setiap hari. Setelah 21 hari, kebiasaan ini akan terasa alami dan mampu menurunkan risiko penyakit degeneratif secara signifikan.',
 NULL, '2026-03-22');

-- =====================================================================
-- 5. TABEL: kandungan_gizi  (nilai per 100 gram)
-- =====================================================================
DROP TABLE IF EXISTS `kandungan_gizi`;
CREATE TABLE `kandungan_gizi` (
    `id_gizi`              INT(11)      NOT NULL AUTO_INCREMENT,
    `id_admin`             INT(11)      DEFAULT NULL,
    `nama_makanan_minuman` VARCHAR(120) NOT NULL,
    `kategori`             ENUM('Makanan','Minuman') NOT NULL DEFAULT 'Makanan',
    `porsi`                VARCHAR(50)  NOT NULL DEFAULT '100 gram',
    `kalori`               DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `karbohidrat`          DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `protein`              DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    `lemak`                DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    PRIMARY KEY (`id_gizi`),
    KEY `fk_gizi_admin` (`id_admin`),
    CONSTRAINT `fk_gizi_admin` FOREIGN KEY (`id_admin`)
        REFERENCES `admin` (`id_admin`) ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `kandungan_gizi`
